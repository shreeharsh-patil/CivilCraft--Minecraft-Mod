{
	"schemaVersion": 1,
	"id": "civilcraftai",
	"version": "${version}",
	"name": "CivilCraft AI",
	"description": "Ultimate Minecraft Civilization Mod with LLM-powered AI agents.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/civilcraftai/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.civilcraftai.CivilCraftAI"
		],
		"client": [
			"com.civilcraftai.client.CivilCraftAIClient"
		]
	},
	"mixins": [
		"civilcraftai.mixins.json",
		{
			"config": "civilcraftai.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	}
}